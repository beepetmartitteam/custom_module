<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Document List View -->
    <record model="ir.ui.view" id="import_document_list">
      <field name="name">import.document.list</field>
      <field name="model">import.document</field>
      <field name="arch" type="xml">
        <list string="Import Documents">
          <field name="document_type"/>
          <field name="document_number"/>
          <field name="document_date"/>
          <field name="shipment_id"/>
          <field name="status"/>
        </list>
      </field>
    </record>

    <!-- Document Form View -->
    <record model="ir.ui.view" id="import_document_form">
      <field name="name">import.document.form</field>
      <field name="model">import.document</field>
      <field name="arch" type="xml">
        <form string="Import Document">
          <header>
            <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="status != 'draft'"/>
            <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="status != 'submitted'"/>
            <button name="action_reject" string="Reject" type="object" invisible="status != 'submitted'"/>
            <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="status not in ['approved', 'rejected', 'expired']"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="document_number"/>
              <h1>
                <field name="document_number" readonly="1"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="document_type"/>
                <field name="document_date"/>
                <field name="expiry_date"/>
              </group>
              <group>
                <field name="shipment_id"/>
                <field name="status"/>
              </group>
            </group>
            <group>
              <field name="attachment" filename="attachment_name"/>
              <field name="attachment_name" invisible="1"/>
            </group>
            <group>
              <field name="notes"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Document Search View -->
    <record model="ir.ui.view" id="import_document_search">
      <field name="name">import.document.search</field>
      <field name="model">import.document</field>
      <field name="arch" type="xml">
        <search string="Import Documents">
          <field name="shipment_id"/>
          <field name="document_type"/>
          <field name="status"/>
          <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
          <filter string="Submitted" name="submitted" domain="[('status','=','submitted')]"/>
          <filter string="Approved" name="approved" domain="[('status','=','approved')]"/>
          <filter string="Rejected" name="rejected" domain="[('status','=','rejected')]"/>
          <filter string="Expired" name="expired" domain="[('status','=','expired')]"/>
          <group expand="0" string="Group By">
            <filter name="group_type" string="Document Type" context="{'group_by':'document_type'}"/>
            <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
            <filter name="group_shipment" string="Shipment" context="{'group_by':'shipment_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Document Action -->
    <record model="ir.actions.act_window" id="action_import_document">
      <field name="name">Documents</field>
      <field name="res_model">import.document</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="import_document_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create your first document!
        </p>
      </field>
    </record>
  </data>
</odoo>