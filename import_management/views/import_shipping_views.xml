<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Shipping List View -->
    <record model="ir.ui.view" id="import_shipping_list">
      <field name="name">import.shipping.list</field>
      <field name="model">import.shipping</field>
      <field name="arch" type="xml">
        <list string="Import Shipping">
          <field name="shipping_line"/>
          <field name="vessel_name"/>
          <field name="voyage_number"/>
          <field name="etd"/>
          <field name="eta"/>
          <field name="status"/>
        </list>
      </field>
    </record>

    <!-- Shipping Form View -->
    <record model="ir.ui.view" id="import_shipping_form">
      <field name="name">import.shipping.form</field>
      <field name="model">import.shipping</field>
      <field name="arch" type="xml">
        <form string="Import Shipping">
          <header>
            <button name="action_depart" string="Depart" type="object" class="btn-primary" invisible="status != 'scheduled'"/>
            <button name="action_arrive" string="Arrive" type="object" class="btn-primary" invisible="status not in ['departed', 'delayed']"/>
            <button name="action_mark_delayed" string="Mark Delayed" type="object" invisible="status not in ['scheduled', 'departed']"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="status == 'cancelled'"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="shipping_line"/>
              <h1>
                <field name="shipping_line" readonly="1"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="shipment_id"/>
                <field name="carrier_id"/>
                <field name="vessel_name"/>
                <field name="voyage_number"/>
              </group>
              <group>
                <field name="etd"/>
                <field name="eta"/>
                <field name="actual_departure"/>
                <field name="actual_arrival"/>
              </group>
            </group>
            <group>
              <field name="status"/>
              <field name="delay_reason" invisible="status != 'delayed'"/>
            </group>
            <group>
              <field name="notes"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Shipping Search View -->
    <record model="ir.ui.view" id="import_shipping_search">
      <field name="name">import.shipping.search</field>
      <field name="model">import.shipping</field>
      <field name="arch" type="xml">
        <search string="Import Shipping">
          <field name="vessel_name"/>
          <field name="voyage_number"/>
          <field name="status"/>
          <filter string="Scheduled" name="scheduled" domain="[('status','=','scheduled')]"/>
          <filter string="Departed" name="departed" domain="[('status','=','departed')]"/>
          <filter string="Delayed" name="delayed" domain="[('status','=','delayed')]"/>
          <filter string="Arrived" name="arrived" domain="[('status','=','arrived')]"/>
          <group expand="0" string="Group By">
            <filter name="group_line" string="Shipping Line" context="{'group_by':'shipping_line'}"/>
            <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
            <filter name="group_shipment" string="Shipment" context="{'group_by':'shipment_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Shipping Action -->
    <record model="ir.actions.act_window" id="action_import_shipping">
      <field name="name">Shipping Lines</field>
      <field name="res_model">import.shipping</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="import_shipping_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create your first shipping line!
        </p>
      </field>
    </record>
  </data>
</odoo>