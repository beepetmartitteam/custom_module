<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Landed Cost Types -->
        <record id="landed_cost_type_freight" model="landed.cost.type">
            <field name="name">Ocean Freight</field>
            <field name="code">FREIGHT</field>
            <field name="sequence">10</field>
            <field name="description">Ocean freight charges for shipping containers</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_insurance" model="landed.cost.type">
            <field name="name">Insurance</field>
            <field name="code">INSURANCE</field>
            <field name="sequence">20</field>
            <field name="description">Marine insurance for imported goods</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_customs" model="landed.cost.type">
            <field name="name">Customs Duty</field>
            <field name="code">CUSTOMS</field>
            <field name="sequence">30</field>
            <field name="description">Import duty and customs charges</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_handling" model="landed.cost.type">
            <field name="name">Handling Charges</field>
            <field name="code">HANDLING</field>
            <field name="sequence">40</field>
            <field name="description">Port handling and loading/unloading charges</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_port" model="landed.cost.type">
            <field name="name">Port Charges</field>
            <field name="code">PORT</field>
            <field name="sequence">50</field>
            <field name="description">Port terminal charges</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_clearance" model="landed.cost.type">
            <field name="name">Customs Clearance</field>
            <field name="code">CLEARANCE</field>
            <field name="sequence">60</field>
            <field name="description">Customs brokerage and clearance fees</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_forwarding" model="landed.cost.type">
            <field name="name">Forwarding</field>
            <field name="code">FORWARDING</field>
            <field name="sequence">70</field>
            <field name="description">Freight forwarder fees</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_trucking" model="landed.cost.type">
            <field name="name">Trucking</field>
            <field name="code">TRUCKING</field>
            <field name="sequence">80</field>
            <field name="description">Inland trucking transportation</field>
            <field name="active">True</field>
        </record>
        
        <record id="landed_cost_type_other" model="landed.cost.type">
            <field name="name">Other Import Expenses</field>
            <field name="code">OTHER</field>
            <field name="sequence">90</field>
            <field name="description">Other miscellaneous import expenses</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
