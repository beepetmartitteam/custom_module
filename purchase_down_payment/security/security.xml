<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================================================
         PURCHASE DOWN PAYMENT USER
    ========================================================== -->

    <record id="group_purchase_down_payment_user" model="res.groups">
        <field name="name">Purchase Down Payment User</field>

        <!--
            User otomatis mendapatkan hak Purchase User.
        -->
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>


    <!-- =========================================================
         PURCHASE DOWN PAYMENT MANAGER
    ========================================================== -->

    <record id="group_purchase_down_payment_manager" model="res.groups">
        <field name="name">Purchase Down Payment Manager</field>

        <!--
            Manager mendapatkan hak Purchase Down Payment User.
        -->
        <field name="implied_ids" eval="[
            (4, ref('purchase_down_payment.group_purchase_down_payment_user'))
        ]"/>
    </record>

</odoo>