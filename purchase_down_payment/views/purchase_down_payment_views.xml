    <!-- =========================================================
         ACTION
    ========================================================== -->

    <record id="action_purchase_down_payment" model="ir.actions.act_window">
        <field name="name">Purchase Down Payments</field>
        <field name="res_model">purchase.down.payment</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- =========================================================
         MENU
    ========================================================== -->

    <menuitem
        id="menu_purchase_down_payment"
        name="Down Payments"
        parent="purchase.menu_purchase_root"
        action="action_purchase_down_payment"
        sequence="41"
