<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         LIST VIEW
    ========================================================== -->

    <record id="view_purchase_down_payment_list" model="ir.ui.view">
        <field name="name">purchase.down.payment.list</field>
        <field name="model">purchase.down.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="proforma_id"/>
                <field name="partner_id"/>
                <field name="currency_id"/>
                <field name="amount"/>
                <field name="payment_amount"/>
                <field name="remaining_amount"/>
                <field name="payment_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- =========================================================
         FORM VIEW
    ========================================================== -->

    <record id="view_purchase_down_payment_form" model="ir.ui.view">
        <field name="name">purchase.down.payment.form</field>
        <field name="model">purchase.down.payment</field>
        <field name="arch" type="xml">
            <form string="Purchase Down Payment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'confirmed'" groups="purchase_down_payment.group_purchase_down_payment_manager"/>
                    <button name="action_register_payment" type="object" string="Register Payment" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled', 'paid')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Purchase Information">
                        <group>
                            <field name="purchase_order_id"/>
                            <field name="proforma_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Down Payment">
                        <group>
                            <field name="amount"/>
                            <field name="payment_amount"/>
                            <field name="remaining_amount"/>
                        </group>
                    </group>
                    <group string="Payment">
                        <group>
                            <field name="payment_date"/>
                            <field name="payment_journal_id"/>
                        </group>
                        <group>
                            <field name="payment_move_id" readonly="1"/>
                            <button
                                name="action_view_payment_move"
                                type="object"
                                string="View Journal Entry"
                                class="btn-link"
                                icon="fa-external-link"
                                invisible="not payment_move_id"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


