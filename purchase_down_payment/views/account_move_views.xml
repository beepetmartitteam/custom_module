<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_purchase_down_payment"
            model="ir.ui.view">

        <field name="name">
            account.move.form.purchase.down.payment
        </field>

        <field name="model">account.move</field>

        <field name="inherit_id"
               ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <!-- ================================================= -->
            <!-- BUTTON -->
            <!-- ================================================= -->

            <xpath expr="//header" position="inside">

                <button
                    name="action_apply_purchase_down_payment"
                    type="object"
                    string="Apply Down Payment"
                    class="btn-primary"
                />

            </xpath>

            <!-- ================================================= -->
            <!-- DOWN PAYMENT INFORMATION -->
            <!-- ================================================= -->

            <xpath expr="//sheet/notebook" position="inside">

                <page
                    string="Down Payments"
                    invisible="move_type != 'in_invoice'"
                >

                    <group>

                        <group>

                            <field
                                name="purchase_down_payment_total"
                                readonly="1"
                            />

                            <field
                                name="purchase_down_payment_remaining"
                                readonly="1"
                            />

                        </group>

                    </group>

                    <field
                        name="purchase_down_payment_application_ids"
                        readonly="1"
                    >

                        <list>

                            <field name="name"/>

                            <field name="down_payment_id"/>

                            <field name="date"/>

                            <field name="amount"/>

                            <field name="application_move_id"/>

                            <field name="state"/>

                        </list>

                    </field>

                </page>

            </xpath>

        </field>

    </record>

</odoo>