<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view for wizard -->
    <record id="view_purchase_down_payment_apply_wizard_form" model="ir.ui.view">
        <field name="name">purchase.down.payment.apply.wizard.form</field>
        <field name="model">purchase.down.payment.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Purchase Down Payment">
                <group>
                    <group>
                        <field name="vendor_bill_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="currency_id" readonly="1"/>
                        <field name="bill_amount" readonly="1"/>
                    </group>
                </group>

                <group>
                    <group>
                        <field name="already_applied" readonly="1"/>
                    </group>
                    <group>
                        <field name="remaining_bill_amount" readonly="1"/>
                    </group>
                </group>

                <separator string="Available Down Payments"/>

                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="selected"/>
                        <field name="down_payment_id"
                               string="Down Payment"
                               readonly="1"
                               force_save="1"/>
                        <field name="available_amount"
                               string="Available / Apply Amount"
                               readonly="1"
                               force_save="1"/>
                        <field name="currency_id"
                               column_invisible="True"/>
                    </list>
                </field>

                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Apply Down Payment"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- List view for wizard line -->
    <record id="view_purchase_down_payment_apply_wizard_line_list" model="ir.ui.view">
        <field name="name">purchase.down.payment.apply.wizard.line.list</field>
        <field name="model">purchase.down.payment.apply.wizard.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="selected"/>
                <field name="down_payment_id"
                       string="Down Payment"
                       readonly="1"/>
                <field name="available_amount"
                       string="Available / Apply Amount"
                       readonly="1"/>
                <field name="currency_id"
                       column_invisible="True"/>
            </list>
        </field>
    </record>

</odoo>
